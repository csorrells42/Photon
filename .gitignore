# Local credentials and machine-bound state
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
*.ppk
auth.json
credentials.json
secrets.json
vault/

# Runtime data, logs, process identity, and local indexes
data/
logs/
workspace/
.serena/
!remote-install/.serena/
!remote-install/.serena/project.yml
*.pid
*.nonce
installer-failure.log
runtime/runtime-image.env
runtime/runtime-image.lock.json
runtime/runtime-image.previous.lock.json
# Receipt-bound CAD images are local engineering inputs, not source or
# redistributable release content. The tracked installer consumes them only
# when explicitly supplied and verified against its immutable lock.
runtime-assets/photon-cad/

