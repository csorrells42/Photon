{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photon.cad.industrial.response/v1",
  "title": "Photon CAD industrial container response",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": false },
        "error": {
          "enum": [
            "artifact-invalid",
            "catalog-mismatch",
            "dependency-unavailable",
            "internal-error",
            "invalid-json",
            "invalid-parameter",
            "invalid-request",
            "item-not-found",
            "operation-failed",
            "request-too-large",
            "resource-limit",
            "timeout",
            "unsupported-operation"
          ]
        }
      },
      "required": ["schema", "ok", "error"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "catalog" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "catalog": { "$ref": "catalog-v1.schema.json" }
      },
      "required": ["schema", "ok", "operation", "catalogDigest", "catalog"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "createPrimitive" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/primitiveProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "createCatalogItem" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "itemId": { "$ref": "#/$defs/itemId" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/catalogProvenance" }
      },
      "required": ["schema", "ok", "operation", "catalogDigest", "itemId", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "createPreview" },
        "artifact": { "$ref": "#/$defs/glbArtifact" },
        "entityCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "sourceCount": { "type": "integer", "minimum": 1, "maximum": 256 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "units": { "const": "millimeter" },
        "provenance": { "$ref": "#/$defs/previewProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "entityCount", "sourceCount", "bounds", "units", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "inspectStepAssembly" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "rootEntityId": { "$ref": "#/$defs/identifier" },
        "definitionCount": { "type": "integer", "minimum": 2, "maximum": 256 },
        "occurrenceCount": { "type": "integer", "minimum": 2, "maximum": 1024 },
        "definitions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/assemblyDefinition" }
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/assemblyOccurrence" }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "sourceDigest": { "$ref": "#/$defs/digest" },
            "sourceByteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 }
          },
          "required": ["sourceDigest", "sourceByteLength"],
          "additionalProperties": false
        }
      },
      "required": ["schema", "ok", "operation", "sourceDigest", "rootEntityId", "definitionCount", "occurrenceCount", "definitions", "occurrences", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "manualSketchExtrudeAdd" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/manualAddProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "manualSketchExtrudeCut" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/manualCutProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "manualHoleCut" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/manualHoleProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "manualLinearPattern" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/manualLinearPatternProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": { "const": "photon.cad.industrial.response/v1" },
        "ok": { "const": true },
        "operation": { "const": "manualCircularPattern" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "provenance": { "$ref": "#/$defs/manualCircularPatternProvenance" }
      },
      "required": ["schema", "ok", "operation", "artifact", "measurement", "provenance"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "itemId": { "type": "string", "pattern": "^bdw_[0-9a-f]{48}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
    },
    "bounds": {
      "type": "object",
      "properties": {
        "minimum": { "$ref": "#/$defs/vector" },
        "maximum": { "$ref": "#/$defs/vector" }
      },
      "required": ["minimum", "maximum"],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "units": { "const": "millimeter" },
        "volumeMm3": { "type": "number", "exclusiveMinimum": 0 },
        "solidCount": { "type": "integer", "minimum": 1 },
        "bounds": { "$ref": "#/$defs/bounds" }
      },
      "required": ["units", "volumeMm3", "solidCount", "bounds"],
      "additionalProperties": false
    },
    "stepArtifact": {
      "type": "object",
      "properties": {
        "format": { "const": "step" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 }
      },
      "required": ["format", "contentDigest", "byteLength"],
      "additionalProperties": false
    },
    "glbArtifact": {
      "type": "object",
      "properties": {
        "format": { "const": "glb" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "byteLength": { "type": "integer", "minimum": 20, "maximum": 134217728 }
      },
      "required": ["format", "contentDigest", "byteLength"],
      "additionalProperties": false
    },
    "assemblyDefinition": {
      "type": "object",
      "properties": {
        "entityId": { "$ref": "#/$defs/identifier" },
        "parentEntityId": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "kind": { "enum": ["part", "assembly"] },
        "partNumber": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "previewSource": { "type": "boolean" },
        "artifact": { "$ref": "#/$defs/stepArtifact" },
        "outputFile": { "oneOf": [{ "type": "string", "pattern": "^definition-[0-9]{4}\\.step$" }, { "type": "null" }] }
      },
      "required": ["entityId", "parentEntityId", "kind", "partNumber", "displayName", "previewSource", "artifact", "outputFile"],
      "additionalProperties": false
    },
    "assemblyOccurrence": {
      "type": "object",
      "properties": {
        "occurrenceId": { "$ref": "#/$defs/identifier" },
        "parentOccurrenceId": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "sourceEntityId": { "$ref": "#/$defs/identifier" },
        "partNumber": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
        "transform": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
        }
      },
      "required": ["occurrenceId", "parentOccurrenceId", "sourceEntityId", "partNumber", "transform"],
      "additionalProperties": false
    },
    "primitiveProvenance": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "generator": { "const": "primitive" },
            "kind": { "const": "box" },
            "parameters": {
              "type": "object",
              "properties": {
                "heightMm": { "type": "number", "exclusiveMinimum": 0 },
                "lengthMm": { "type": "number", "exclusiveMinimum": 0 },
                "widthMm": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["heightMm", "lengthMm", "widthMm"],
              "additionalProperties": false
            }
          },
          "required": ["generator", "kind", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "generator": { "const": "primitive" },
            "kind": { "const": "cylinder" },
            "parameters": {
              "type": "object",
              "properties": {
                "heightMm": { "type": "number", "exclusiveMinimum": 0 },
                "radiusMm": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["heightMm", "radiusMm"],
              "additionalProperties": false
            }
          },
          "required": ["generator", "kind", "parameters"],
          "additionalProperties": false
        }
      ]
    },
    "catalogProvenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "catalog" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "itemId": { "$ref": "#/$defs/itemId" },
        "parameters": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
        }
      },
      "required": ["generator", "catalogDigest", "itemId", "parameters"],
      "additionalProperties": false
    },
    "manualProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "rectangle" },
            "plane": { "const": "xy" },
            "widthMm": { "type": "number", "exclusiveMinimum": 0 },
            "heightMm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["kind", "plane", "widthMm", "heightMm"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "circle" },
            "plane": { "const": "xy" },
            "radiusMm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["kind", "plane", "radiusMm"],
          "additionalProperties": false
        }
      ]
    },
    "manualAddProvenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "manual" },
        "kind": { "const": "sketchExtrudeAdd" },
        "profile": { "$ref": "#/$defs/manualProfile" },
        "depthMm": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["generator", "kind", "profile", "depthMm"],
      "additionalProperties": false
    },
    "manualCutProvenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "manual" },
        "kind": { "const": "sketchExtrudeCut" },
        "profile": { "$ref": "#/$defs/manualProfile" },
        "depthMm": { "type": "number", "exclusiveMinimum": 0 },
        "sourceVolumeMm3": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["generator", "kind", "profile", "depthMm", "sourceVolumeMm3"],
      "additionalProperties": false
    },
    "manualHoleProvenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "manual" },
        "kind": { "const": "holeCut" },
        "hole": {
          "type": "object",
          "properties": {
            "depthMm": { "type": "number", "exclusiveMinimum": 0 },
            "radiusMm": { "type": "number", "exclusiveMinimum": 0 },
            "xMm": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            "yMm": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            "zMm": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          },
          "required": ["depthMm", "radiusMm", "xMm", "yMm", "zMm"],
          "additionalProperties": false
        },
        "sourceVolumeMm3": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["generator", "kind", "hole", "sourceVolumeMm3"],
      "additionalProperties": false
    },
    "manualLinearPatternProvenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "manual" },
        "kind": { "const": "linearPattern" },
        "seedKind": { "enum": ["sketchExtrudeCut", "holeCut"] },
        "count": { "type": "integer", "minimum": 2, "maximum": 256 },
        "spacingMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "sourceVolumeMm3": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["generator", "kind", "seedKind", "count", "spacingMm", "sourceVolumeMm3"],
      "additionalProperties": false
    },
    "manualCircularPatternProvenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "manual" },
        "kind": { "const": "circularPattern" },
        "seedKind": { "const": "holeCut" },
        "count": { "type": "integer", "minimum": 2, "maximum": 256 },
        "angleDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "sourceVolumeMm3": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["generator", "kind", "seedKind", "count", "angleDegrees", "sourceVolumeMm3"],
      "additionalProperties": false
    },
    "previewProvenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "sourcePartId": { "$ref": "#/$defs/identifier" },
              "contentDigest": { "$ref": "#/$defs/digest" },
              "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 }
            },
            "required": ["sourcePartId", "contentDigest", "byteLength"],
            "additionalProperties": false
          }
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "entityId": { "$ref": "#/$defs/identifier" },
              "sourcePartId": {
                "oneOf": [
                  { "$ref": "#/$defs/identifier" },
                  { "type": "null" }
                ]
              },
              "parentEntityId": {
                "oneOf": [
                  { "$ref": "#/$defs/identifier" },
                  { "type": "null" }
                ]
              },
              "transform": {
                "type": "array",
                "minItems": 16,
                "maxItems": 16,
                "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
              }
            },
            "required": ["entityId", "sourcePartId", "parentEntityId", "transform"],
            "additionalProperties": false
          }
        },
        "tessellation": {
          "type": "object",
          "properties": {
            "linearToleranceMm": { "type": "number", "minimum": 0.01, "maximum": 10 },
            "angularToleranceRad": { "type": "number", "minimum": 0.01, "maximum": 1 }
          },
          "required": ["linearToleranceMm", "angularToleranceRad"],
          "additionalProperties": false
        }
      },
      "required": ["sources", "occurrences", "tessellation"],
      "additionalProperties": false
    }
  }
}
