{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photon.cad.industrial.request/v1",
  "title": "Photon CAD industrial container request",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "catalog" }
      },
      "required": ["schema", "operation"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "createPrimitive" },
        "primitive": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": { "const": "box" },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "lengthMm": { "$ref": "#/$defs/positiveDimension" },
                    "widthMm": { "$ref": "#/$defs/positiveDimension" },
                    "heightMm": { "$ref": "#/$defs/positiveDimension" }
                  },
                  "required": ["lengthMm", "widthMm", "heightMm"],
                  "additionalProperties": false
                }
              },
              "required": ["kind", "dimensions"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "const": "cylinder" },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "radiusMm": { "$ref": "#/$defs/positiveDimension" },
                    "heightMm": { "$ref": "#/$defs/positiveDimension" }
                  },
                  "required": ["radiusMm", "heightMm"],
                  "additionalProperties": false
                }
              },
              "required": ["kind", "dimensions"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["schema", "operation", "primitive"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "createCatalogItem" },
        "catalogDigest": { "$ref": "#/$defs/digest" },
        "itemId": { "type": "string", "pattern": "^bdw_[0-9a-f]{48}$" },
        "parameters": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      },
      "required": ["schema", "operation", "catalogDigest", "itemId", "parameters"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "createPreview" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/source" }
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/occurrence" }
        },
        "tessellation": {
          "type": "object",
          "properties": {
            "linearToleranceMm": { "type": "number", "minimum": 0.01, "maximum": 10 },
            "angularToleranceRad": { "type": "number", "minimum": 0.01, "maximum": 1 }
          },
          "required": ["linearToleranceMm", "angularToleranceRad"],
          "additionalProperties": false
        }
      },
      "required": ["schema", "operation", "sources", "occurrences"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "inspectStepAssembly" },
        "source": { "$ref": "#/$defs/manualSource" }
      },
      "required": ["schema", "operation", "source"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "manualSketchExtrudeAdd" },
        "profile": { "$ref": "#/$defs/manualProfile" },
        "depthMm": { "$ref": "#/$defs/positiveDimension" }
      },
      "required": ["schema", "operation", "profile", "depthMm"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "manualSketchExtrudeCut" },
        "source": { "$ref": "#/$defs/manualSource" },
        "profile": { "$ref": "#/$defs/manualProfile" },
        "depthMm": { "$ref": "#/$defs/positiveDimension" }
      },
      "required": ["schema", "operation", "source", "profile", "depthMm"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schema": { "const": "photon.cad.industrial.request/v1" },
        "operation": { "const": "manualHoleCut" },
        "source": { "$ref": "#/$defs/manualSource" },
        "hole": {
          "type": "object",
          "properties": {
            "radiusMm": { "$ref": "#/$defs/positiveDimension" },
            "depthMm": { "$ref": "#/$defs/positiveDimension" },
            "xMm": { "$ref": "#/$defs/signedDimension" },
            "yMm": { "$ref": "#/$defs/signedDimension" },
            "zMm": { "$ref": "#/$defs/signedDimension" }
          },
          "required": ["radiusMm", "depthMm", "xMm", "yMm", "zMm"],
          "additionalProperties": false
        }
      },
      "required": ["schema", "operation", "source", "hole"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "slot": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "positiveDimension": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
    "signedDimension": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
    "manualSource": {
      "type": "object",
      "properties": {
        "inputSlot": { "$ref": "#/$defs/slot" },
        "expectedDigest": { "$ref": "#/$defs/digest" }
      },
      "required": ["inputSlot", "expectedDigest"],
      "additionalProperties": false
    },
    "manualProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "rectangle" },
            "plane": { "const": "xy" },
            "widthMm": { "$ref": "#/$defs/positiveDimension" },
            "heightMm": { "$ref": "#/$defs/positiveDimension" }
          },
          "required": ["kind", "plane", "widthMm", "heightMm"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "circle" },
            "plane": { "const": "xy" },
            "radiusMm": { "$ref": "#/$defs/positiveDimension" }
          },
          "required": ["kind", "plane", "radiusMm"],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "sourcePartId": { "$ref": "#/$defs/identifier" },
        "inputSlot": { "$ref": "#/$defs/slot" },
        "expectedDigest": { "$ref": "#/$defs/digest" }
      },
      "required": ["sourcePartId", "inputSlot", "expectedDigest"],
      "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "properties": {
        "entityId": { "$ref": "#/$defs/identifier" },
        "sourcePartId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "parentEntityId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "transform": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "type": "number", "minimum": -1000000000, "maximum": 1000000000 }
        }
      },
      "required": ["entityId", "sourcePartId", "parentEntityId", "transform"],
      "additionalProperties": false
    }
  }
}
