<Window x:Class="HermesDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Phos Agape Aphthartos"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/photon-mark.png"
        Background="{StaticResource WindowBackground}">
  <Grid Background="{StaticResource WindowBackground}">
    <!-- Both surfaces must participate in the WPF compositor. Mixing native
         HWND WebView children with renderer controls caused white browser
         slabs and stale child windows that intercepted unrelated clicks. -->
    <wv2:WebView2CompositionControl x:Name="WorkbenchView" Visibility="Hidden" />
    <wv2:WebView2CompositionControl x:Name="BrowserView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Border x:Name="LoadingSurface" Background="#090B12">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="64" Height="64" CornerRadius="18" Margin="0,0,0,18" ClipToBounds="True">
          <Image Source="Assets/photon-mark.png" Stretch="UniformToFill" />
        </Border>
        <TextBlock Text="Phos Agape Aphthartos" Foreground="#E3E6EF" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="LoadingMessage" Text="Connecting to the local Workbench…" Foreground="#737D90" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
        <Button x:Name="RetryButton" Content="Retry" Visibility="Collapsed" Click="RetryClicked" Margin="0,18,0,0" Padding="18,7" Background="#6F58D8" Foreground="White" BorderThickness="0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
