<Window x:Class="ChatGptVoicePanelPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ChatGPT Voice Panel Prototype" Height="720" Width="460">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" Background="#202124">
      <StackPanel Orientation="Horizontal">
        <Button Margin="0,0,8,0" Padding="10,4" Click="Reload_Click">Reload</Button>
        <TextBlock VerticalAlignment="Center" Foreground="White" Text="Uses your ChatGPT web session; no API billing." />
      </StackPanel>
    </Border>
    <Grid>
      <wv2:WebView2 x:Name="Browser" />
      <Border x:Name="FailurePanel" Visibility="Collapsed" Background="#FFF4F4F4">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
          <TextBlock x:Name="FailureText" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" />
          <Button Margin="0,16,0,0" Padding="10,6" Click="Retry_Click">Retry</Button>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
