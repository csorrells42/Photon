<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildProjectDirectory)\..\..\..\..\..\..\artifacts\HermesPythonLanguageTooling.Smoke\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\..\..\..\..\..\..\artifacts\HermesPythonLanguageTooling.Smoke\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);HERMES_PYTHON_TOOLING_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PythonLanguageToolingSmoke.cs" />
    <ProjectReference Include="..\..\..\HermesDeveloperServices.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
