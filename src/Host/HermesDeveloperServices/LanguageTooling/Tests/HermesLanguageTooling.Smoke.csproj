<Project>
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildProjectDirectory)\..\..\..\..\..\artifacts\HermesLanguageTooling.Smoke\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\..\..\..\..\..\artifacts\HermesLanguageTooling.Smoke\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);HERMES_LANGUAGE_TOOLING_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LanguageToolingSmoke.cs" />
    <Compile Include="ConcreteOperationHandlersSmoke.cs" />
    <Compile Include="ContainerGccAuthoritySmoke.cs" />
    <ProjectReference Include="..\..\HermesDeveloperServices.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
